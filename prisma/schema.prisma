// Prisma schema — Diskominfo SP HST Rebuild
// HANYA untuk data lokal milik portal baru.
// JANGAN buat tabel `News` / `HoaxReport`: berita, pengumuman, dan hoaks
// sepenuhnya berasal dari API Media Center HST (mediacenter.hstkab.go.id).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Statistik kunjungan portal (data lokal).
model VisitorStat {
  id        String   @id @default(cuid())
  path      String
  referrer  String?
  userAgent String?
  country   String?
  visitedAt DateTime @default(now())

  @@index([path])
  @@index([visitedAt])
}

/// Subscriber siaran radio pemerintah daerah (data lokal).
model RadioSubscriber {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  phone        String?
  isActive     Boolean  @default(true)
  subscribedAt DateTime @default(now())
}

/// Cache feed media sosial (data lokal, sementara).
model SocialMediaCache {
  id        String   @id @default(cuid())
  platform  String
  payload   Json
  fetchedAt DateTime @default(now())
  expiresAt DateTime

  @@index([platform])
}

/// Reservasi layanan publik (data lokal).
/// Permohonan kunjungan/studi tiru, permohonan publikasi, penggunaan aula,
/// permohonan narasumber, dan peminjaman peralatan.
model ServiceReservation {
  id            String    @id @default(cuid())
  /// Kode lacak singkat yang diberikan ke pemohon (mis. RSV-7K2M9Q).
  kode          String    @unique
  /// Nama pemohon / penanggung jawab.
  nama          String
  /// Instansi/lembaga asal (boleh kosong untuk perorangan).
  instansi      String?
  email         String
  telepon       String
  /// Jenis layanan yang diminta (lihat LAYANAN_RESERVASI).
  layanan       String
  /// Tanggal kegiatan yang diminta.
  tanggal       DateTime
  /// Jam mulai "HH:MM" (waktu lokal WITA).
  waktuMulai    String
  /// Jam selesai "HH:MM" (opsional).
  waktuSelesai  String?
  /// Perkiraan jumlah peserta.
  jumlahPeserta Int
  /// Uraian keperluan/kegiatan.
  keperluan     String
  /// MENUNGGU | DISETUJUI | DITOLAK | SELESAI
  status        String    @default("MENUNGGU")
  /// Catatan dari admin (alasan penolakan, instruksi, dsb.).
  catatanAdmin  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([status])
  @@index([tanggal])
  @@index([createdAt])
}

/// Survei kepuasan layanan masyarakat (data lokal).
/// Mengikuti 9 unsur Indeks Kepuasan Masyarakat (IKM) — PermenPANRB 14/2017.
/// Setiap unsur dinilai 1–4 (Tidak Baik / Kurang Baik / Baik / Sangat Baik).
model ServiceSurvey {
  id        String   @id @default(cuid())
  /// Nama layanan yang dinilai (mis. "Layanan Publikasi & Dokumentasi").
  layanan   String
  /// 9 unsur IKM.
  u1        Int
  u2        Int
  u3        Int
  u4        Int
  u5        Int
  u6        Int
  u7        Int
  u8        Int
  u9        Int
  /// Nilai IKM terhitung (0–100) dan mutu pelayanan (A/B/C/D).
  ikm       Float
  mutu      String
  /// Saran/masukan, identitas opsional (boleh anonim).
  saran     String?
  nama      String?
  kontak    String?
  createdAt DateTime @default(now())

  @@index([layanan])
  @@index([createdAt])
}

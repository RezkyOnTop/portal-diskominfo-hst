// Prisma schema — Diskominfo SP HST Rebuild
// HANYA untuk data lokal milik portal baru.
// JANGAN buat tabel `News` / `HoaxReport`: berita, pengumuman, dan hoaks
// sepenuhnya berasal dari API Media Center HST (mediacenter.hstkab.go.id).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Statistik kunjungan portal (data lokal).
model VisitorStat {
  id        String   @id @default(cuid())
  path      String
  referrer  String?
  userAgent String?
  country   String?
  visitedAt DateTime @default(now())

  @@index([path])
  @@index([visitedAt])
}

/// Subscriber siaran radio pemerintah daerah (data lokal).
model RadioSubscriber {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  phone        String?
  isActive     Boolean  @default(true)
  subscribedAt DateTime @default(now())
}

/// Cache feed media sosial (data lokal, sementara).
model SocialMediaCache {
  id        String   @id @default(cuid())
  platform  String
  payload   Json
  fetchedAt DateTime @default(now())
  expiresAt DateTime

  @@index([platform])
}

/// Reservasi layanan publik (data lokal).
/// Permohonan kunjungan/studi tiru, permohonan publikasi, penggunaan aula,
/// permohonan narasumber, dan peminjaman peralatan.
model ServiceReservation {
  id            String    @id @default(cuid())
  /// Kode lacak singkat yang diberikan ke pemohon (mis. RSV-7K2M9Q).
  kode          String    @unique
  /// Nama pemohon / penanggung jawab.
  nama          String
  /// Instansi/lembaga asal (boleh kosong untuk perorangan).
  instansi      String?
  email         String
  telepon       String
  /// Jenis layanan yang diminta (lihat LAYANAN_RESERVASI).
  layanan       String
  /// Tanggal kegiatan yang diminta.
  tanggal       DateTime
  /// Jam mulai "HH:MM" (waktu lokal WITA).
  waktuMulai    String
  /// Jam selesai "HH:MM" (opsional).
  waktuSelesai  String?
  /// Perkiraan jumlah peserta.
  jumlahPeserta Int
  /// Uraian keperluan/kegiatan.
  keperluan     String
  /// MENUNGGU | DISETUJUI | DITOLAK | SELESAI
  status        String    @default("MENUNGGU")
  /// Catatan dari admin (alasan penolakan, instruksi, dsb.).
  catatanAdmin  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([status])
  @@index([tanggal])
  @@index([createdAt])
}

/// Survei kepuasan layanan masyarakat (data lokal).
/// Mengikuti 9 unsur Indeks Kepuasan Masyarakat (IKM) — PermenPANRB 14/2017.
/// Setiap unsur dinilai 1–4 (Tidak Baik / Kurang Baik / Baik / Sangat Baik).
model ServiceSurvey {
  id        String   @id @default(cuid())
  /// Nama layanan yang dinilai (mis. "Layanan Publikasi & Dokumentasi").
  layanan   String
  /// 9 unsur IKM.
  u1        Int
  u2        Int
  u3        Int
  u4        Int
  u5        Int
  u6        Int
  u7        Int
  u8        Int
  u9        Int
  /// Nilai IKM terhitung (0–100) dan mutu pelayanan (A/B/C/D).
  ikm       Float
  mutu      String
  /// Saran/masukan, identitas opsional (boleh anonim).
  saran     String?
  nama      String?
  kontak    String?
  createdAt DateTime @default(now())

  @@index([layanan])
  @@index([createdAt])
}

/// Pengaduan & aspirasi masyarakat (data lokal).
/// Warga mengirim lewat form di /kontak tanpa perlu akun/email aktif; setiap
/// pengaduan menerima kode lacak. Petugas menanggapi lewat /dashboard/pengaduan.
model Pengaduan {
  id        String   @id @default(cuid())
  /// Kode lacak singkat yang diberikan ke pengadu (mis. PGD-7K2M9Q).
  kode      String   @unique
  nama      String
  /// Kontak pengadu: nomor WhatsApp/telepon atau email (bebas).
  kontak    String
  /// Kategori pengaduan (lihat KATEGORI_PENGADUAN).
  kategori  String
  /// Isi pengaduan/aspirasi.
  isi       String
  /// BARU | DIPROSES | SELESAI
  status    String   @default("BARU")
  /// Tanggapan/respons petugas (tampil ke pengadu lewat cek status).
  tanggapan String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}

/// Data pegawai dinas (data lokal).
/// Dikelola admin lewat /dashboard/pegawai; ditampilkan publik di
/// /profil/data-pegawai. Foto diunggah ke berkas terpisah (lihat
/// lib/storage/foto.ts) dan disajikan lewat /api/pegawai/foto/[id];
/// bila fotoUrl kosong, UI memakai avatar inisial sebagai gambar default.
model Staff {
  id        String   @id @default(cuid())
  /// Nama lengkap beserta gelar.
  nama      String
  /// NIP/NIK — boleh kosong (situs lama belum mengisi kolom ini).
  nip       String?
  /// Jabatan atau peran.
  jabatan   String
  /// Unit kerja / kelompok (lihat UNIT_PEGAWAI).
  unit      String
  /// URL foto; null = pakai gambar default (avatar inisial).
  fotoUrl   String?
  /// Urutan tampil dalam satu unit (kecil lebih dulu).
  urutan    Int      @default(0)
  /// Sembunyikan dari halaman publik tanpa menghapus data.
  aktif     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([unit])
  @@index([urutan])
  @@index([aktif])
}

/// Jejak audit aktivitas dashboard admin (data lokal).
/// Dicatat dari lib/services/audit.ts setiap kali admin/editor melakukan
/// tindakan berarti: masuk/keluar, ubah data, unggah/hapus foto, ekspor CSV.
/// Penulisan bersifat best-effort — kegagalan mencatat TIDAK boleh menggagalkan
/// aksi utama yang sedang dijalankan pengguna.
model AuditLog {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  /// Id akun pelaku (id tabel User, atau "env-admin" untuk akun environment).
  actorId   String?
  /// Nama tampilan pelaku saat aksi terjadi (disalin, bukan relasi).
  actorName String
  /// Peran pelaku: ADMIN | EDITOR | ANONIM.
  actorRole String
  /// Kode aksi, mis. MASUK, UBAH_PEGAWAI, UNGGAH_FOTO_PEGAWAI.
  aksi      String
  /// Jenis objek yang disentuh (Staff, Pengaduan, User, …).
  target    String?
  /// Id objek yang disentuh.
  targetId  String?
  /// Ringkasan manusiawi (apa yang berubah).
  detail    String?
  /// Alamat IP pelaku (dari X-Forwarded-For / X-Real-IP bila ada).
  ip        String?
  userAgent String?

  @@index([createdAt])
  @@index([actorId])
  @@index([aksi])
}

/// Akun pengguna dashboard admin (data lokal).
/// Dikelola admin lewat /dashboard/pengguna ("Kelola User"): tambah akun,
/// ubah nama/email/peran, ganti password, aktif/nonaktif, dan hapus.
/// Password TIDAK pernah disimpan polos — hanya hash bcrypt (lihat
/// lib/services/user.ts). Akun utama dari environment (ADMIN_EMAIL /
/// ADMIN_PASSWORD_HASH) tetap berlaku sebagai cadangan/super admin.
model User {
  id           String   @id @default(cuid())
  /// Identitas login (huruf kecil, unik) — boleh email atau username singkat
  /// seperti "admin". Dipakai untuk masuk di /masuk.
  username     String   @unique
  /// Nama tampilan pemilik akun.
  nama         String
  /// Hash bcrypt password (cost 12). Tidak pernah ditampilkan ke UI.
  passwordHash String
  /// Peran: ADMIN (akses penuh) | EDITOR (kelola konten, tanpa kelola user).
  role         String   @default("EDITOR")
  /// Nonaktifkan akun tanpa menghapus riwayatnya.
  aktif        Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([role])
  @@index([aktif])
}

/// Slide foto slideshow hero beranda (data lokal).
/// Dikelola admin lewat /dashboard/hero; ditampilkan publik di Hero.
/// Foto diunggah ke berkas terpisah (lihat lib/storage/foto-hero.ts) dan
/// disajikan lewat /api/hero/foto/[id]. Bila belum ada slide sama sekali,
/// komponen memakai 6 foto bawaan di public/brand sebagai gambar default.
model HeroSlide {
  id        String   @id @default(cuid())
  /// Keterangan foto (untuk label aksesibilitas + aria slideshow).
  label     String
  /// URL foto; null = belum diunggah (slide dilewati di slideshow publik).
  fotoUrl   String?
  /// Urutan tampil di slideshow (kecil lebih dulu).
  urutan    Int      @default(0)
  /// Sembunyikan dari halaman publik tanpa menghapus foto.
  aktif     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([urutan])
  @@index([aktif])
}

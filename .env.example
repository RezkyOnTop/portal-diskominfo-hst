# Salin ke .env.local (dev) / set di hosting (prod). JANGAN commit file .env*.
# Generate secret: openssl rand -base64 32

# PostgreSQL lokal (data lokal: VisitorStat, RadioSubscriber, SocialMediaCache,
# ServiceSurvey — berita/pengumuman/hoaks TIDAK ada di sini)
DATABASE_URL="postgresql://user:password@localhost:5432/diskominfosp_hst"

# NextAuth (area admin lokal)
# Satu sumber kebenaran: AUTH_SECRET (dibaca lebih dulu oleh Auth.js v5).
# NEXTAUTH_SECRET masih diterima sebagai cadangan, tetapi JANGAN diisi keduanya
# dengan nilai berbeda — sesi akan berpindah kunci tanpa penjelasan.
AUTH_SECRET="replace-with-openssl-rand-base64-32"
# Akun administrator UTAMA (dibuat scripts/setup-admin.mjs). Selain akun ini,
# Administrator bisa menambah banyak akun dashboard lewat menu "Kelola User"
# (/dashboard/pengguna) — tersimpan di tabel User, dengan peran ADMIN/EDITOR.
# ADMIN_EMAIL / ADMIN_PASSWORD_HASH tetap berlaku sebagai cadangan bila tabel
# User kosong.
# PENTING: harus sama dengan alamat yang diketik di browser. Setelah login,
# Auth.js mengarahkan browser ke nilai ini — kalau dibiarkan "localhost",
# pengunjung dari luar akan diarahkan ke komputer mereka sendiri ("site can't
# be reached"). Untuk akses lewat IP/domain, isi alamat publiknya, mis.:
#   http://<IP-publik>:3010   atau   https://diskominfosp.hstkab.go.id
NEXTAUTH_URL="http://localhost:3000"

# API Media Center HST (sumber berita/pengumuman/hoaks — BUKAN database lokal)
# Catatan: host Media Center mengekspos endpoint di bawah /api (mis. /api/berita).
MEDIA_CENTER_API_BASE_URL="https://mediacenter.hstkab.go.id"

# Host GAMBAR Media Center (BERBEDA dari host API — jangan disamakan!)
# Foto berita: {MEDIA_CENTER_IMAGE_BASE_URL}/assets/foto_brt/{foto}
MEDIA_CENTER_IMAGE_BASE_URL="https://data-mediacenter.hstkab.go.id"

# Stream radio pemerintah daerah
RADIO_STREAM_URL="https://radio.hstkab.go.id"

# API publik Open Data HST (katalog dataset terbuka — BUKAN database lokal).
# Endpoint publik tanpa API key: {BASE}/api/public/datasets
OPENDATA_API_BASE_URL="https://opendata.hstkab.go.id"

# API publik BMKG untuk widget cuaca (tanpa API key).
# Kode wilayah (adm4) default: 63.07.06.1001 = Barabai Darat, Kec. Barabai —
# kelurahan terdekat dari kantor (Benawa Tengah belum terdaftar di BMKG).
BMKG_API_BASE_URL="https://api.bmkg.go.id"
BMKG_ADM4="63.07.06.1001"

# Chatbot AI (asisten virtual di widget combo pojok kanan bawah).
# Key HANYA di server — TIDAK pernah dikirim ke browser. Ambil di:
#   https://console.groq.com/keys
# Biarkan kosong bila belum ada; widget menampilkan pesan "belum diaktifkan"
# (fitur cuaca tetap jalan). JANGAN commit nilai aslinya.
# (Dulu Gemini; diganti karena Gemini memblokir IP datacenter server ini:
# "User location is not supported". Sisa GEMINI_* lama diabaikan kode.)
GROQ_API_KEY=""
# Model Groq yang masih hidup (per Okt 2026). Default:
# "llama-3.3-70b-versatile". Alternatif cepat: "llama-3.1-8b-instant".
GROQ_MODEL="llama-3.3-70b-versatile"
# Opsional: override base URL + proxy egress bila dibutuhkan.
# GROQ_BASE_URL="https://api.groq.com/openai/v1"
# GROQ_PROXY_URL="http://user:pass@proxy-contoh:8080"

# --- Rate limit / proxy (opsional) -------------------------------------------
# Aplikasi ini jalan tanpa reverse proxy (mis. langsung :3010), sehingga header
# X-Forwarded-For dapat dipalsukan klien. Rate limiter tetap aman karena ada
# ember GLOBAL per fitur, tetapi batas per-IP baru akurat bila Nginx/Caddy
# dipasang di depan dan nilai ini diisi jumlah hop proxy-nya (biasanya 1).
# TRUSTED_PROXY_HOPS="1"
